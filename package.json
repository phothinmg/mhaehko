{
  "name": "mhaehko",
  "version": "0.1.0",
  "description": "Analyze a TypeScript/JavaScript project's dependencies and generates a dependency graph using TypeScript APIs",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "lint": "biome check src --write && biome check opt --write",
    "format": "biome format --write",
    "test": "tsx --test test/*.test.ts",
    "coverage": "tsx opt/lcov/index.ts",
    "build": "tsx opt/build/index.ts"
  },
  "keywords": [
    "dependencies",
    "dependency",
    "graph",
    "circular"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "author": "Pho Thin Mg <phothinmg@disroot.org>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/node": "^25.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "repository": {
    "url": "git+https://github.com/phothinmg/mhaehko.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/phothinmg/mhaehko/issues"
  }
}
